USE NS mensetsu DB production;

DEFINE FIELD OVERWRITE extracted_skills.* ON TABLE resume TYPE any;
DEFINE FIELD OVERWRITE experience.* ON TABLE resume TYPE any;
DEFINE FIELD OVERWRITE education.* ON TABLE resume TYPE any;
DEFINE FIELD OVERWRITE salary.* ON TABLE job_description TYPE any;
DEFINE FIELD OVERWRITE requirements.* ON TABLE job_description TYPE any;
DEFINE FIELD OVERWRITE source_evidence.* ON TABLE job_description TYPE any;
DEFINE FIELD OVERWRITE dossier ON TABLE company_research TYPE object;
DEFINE FIELD OVERWRITE dossier.* ON TABLE company_research TYPE any;
DEFINE FIELD OVERWRITE strengths.* ON TABLE match_analysis TYPE object;
DEFINE FIELD OVERWRITE strengths.*.skill ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE strengths.*.evidence_quote ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE strengths.*.relevance ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps.* ON TABLE match_analysis TYPE object;
DEFINE FIELD OVERWRITE gaps.*.skill ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps.*.importance ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps.*.requirement_quote ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps.*.recommended_focus ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE wording_improvements.* ON TABLE match_analysis TYPE object;
DEFINE FIELD OVERWRITE wording_improvements.*.original_text ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE wording_improvements.*.suggested_revision ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE wording_improvements.*.rationale ON TABLE match_analysis TYPE string;

DEFINE TABLE OVERWRITE workflow_run SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE workflow_run TYPE record<workspace>;
DEFINE FIELD OVERWRITE user_id ON TABLE workflow_run TYPE string;
DEFINE FIELD OVERWRITE workflow_id ON TABLE workflow_run TYPE string;
DEFINE FIELD OVERWRITE workflow_name ON TABLE workflow_run TYPE string;
DEFINE FIELD OVERWRITE type ON TABLE workflow_run TYPE string ASSERT $value IN ['static', 'dynamic'];
DEFINE FIELD OVERWRITE status ON TABLE workflow_run TYPE string ASSERT $value IN ['pending', 'running', 'completed', 'failed', 'cancelled'];
DEFINE FIELD OVERWRITE current_phase ON TABLE workflow_run TYPE string;
DEFINE FIELD OVERWRITE plan_revision ON TABLE workflow_run TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE progress ON TABLE workflow_run TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE last_seq ON TABLE workflow_run TYPE int DEFAULT 0;
DEFINE FIELD OVERWRITE started_at ON TABLE workflow_run TYPE option<datetime>;
DEFINE FIELD OVERWRITE completed_at ON TABLE workflow_run TYPE option<datetime>;
DEFINE FIELD OVERWRITE duration_ms ON TABLE workflow_run TYPE option<float>;
DEFINE FIELD OVERWRITE created_at ON TABLE workflow_run TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE updated_at ON TABLE workflow_run TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE error_message ON TABLE workflow_run TYPE option<string>;
DEFINE INDEX IF NOT EXISTS idx_workflow_run_workspace ON TABLE workflow_run COLUMNS workspace_id;
DEFINE INDEX IF NOT EXISTS idx_workflow_run_created_at ON TABLE workflow_run COLUMNS created_at;

DEFINE TABLE OVERWRITE workflow_task SCHEMAFULL;
DEFINE FIELD OVERWRITE run_id ON TABLE workflow_task TYPE record<workflow_run>;
DEFINE FIELD OVERWRITE task_type ON TABLE workflow_task TYPE string;
DEFINE FIELD OVERWRITE name ON TABLE workflow_task TYPE string;
DEFINE FIELD OVERWRITE assigned_agent ON TABLE workflow_task TYPE string;
DEFINE FIELD OVERWRITE dependencies ON TABLE workflow_task TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE status ON TABLE workflow_task TYPE string ASSERT $value IN ['pending', 'queued', 'running', 'completed', 'failed', 'retrying', 'blocked', 'cancelled', 'skipped'];
DEFINE FIELD OVERWRITE attempt ON TABLE workflow_task TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE required ON TABLE workflow_task TYPE bool DEFAULT true;
DEFINE FIELD OVERWRITE added_in_revision ON TABLE workflow_task TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE execution_ids ON TABLE workflow_task TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE input_data ON TABLE workflow_task TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE output_data ON TABLE workflow_task TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE error ON TABLE workflow_task TYPE option<string>;
DEFINE FIELD OVERWRITE created_at ON TABLE workflow_task TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE updated_at ON TABLE workflow_task TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_workflow_task_run ON TABLE workflow_task COLUMNS run_id;

DEFINE TABLE OVERWRITE agent_execution SCHEMAFULL;
DEFINE FIELD OVERWRITE run_id ON TABLE agent_execution TYPE record<workflow_run>;
DEFINE FIELD OVERWRITE task_id ON TABLE agent_execution TYPE string;
DEFINE FIELD OVERWRITE parent_execution_id ON TABLE agent_execution TYPE option<string>;
DEFINE FIELD OVERWRITE child_execution_ids ON TABLE agent_execution TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE agent_id ON TABLE agent_execution TYPE string;
DEFINE FIELD OVERWRITE objective ON TABLE agent_execution TYPE string DEFAULT '';
DEFINE FIELD OVERWRITE status ON TABLE agent_execution TYPE string ASSERT $value IN ['pending', 'running', 'completed', 'failed', 'cancelled'];
DEFINE FIELD OVERWRITE delegation_depth ON TABLE agent_execution TYPE int DEFAULT 0;
DEFINE FIELD OVERWRITE retries ON TABLE agent_execution TYPE int DEFAULT 0;
DEFINE FIELD OVERWRITE current_activity ON TABLE agent_execution TYPE option<string>;
DEFINE FIELD OVERWRITE model_provider ON TABLE agent_execution TYPE string DEFAULT '';
DEFINE FIELD OVERWRITE model_name ON TABLE agent_execution TYPE string DEFAULT '';
DEFINE FIELD OVERWRITE budgets ON TABLE agent_execution TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE budgets_used ON TABLE agent_execution TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE tool_call_count ON TABLE agent_execution TYPE int DEFAULT 0;
DEFINE FIELD OVERWRITE notes ON TABLE agent_execution TYPE array<object> DEFAULT [];
DEFINE FIELD OVERWRITE notes.* ON TABLE agent_execution TYPE object FLEXIBLE;
DEFINE FIELD OVERWRITE artifact_ids ON TABLE agent_execution TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE public_summary ON TABLE agent_execution TYPE string DEFAULT '';
DEFINE FIELD OVERWRITE error ON TABLE agent_execution TYPE option<string>;
DEFINE FIELD OVERWRITE started_at ON TABLE agent_execution TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE completed_at ON TABLE agent_execution TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS idx_agent_execution_run ON TABLE agent_execution COLUMNS run_id;

DEFINE TABLE OVERWRITE delegated_to TYPE RELATION IN agent_execution OUT agent_execution SCHEMAFULL;
DEFINE FIELD OVERWRITE delegation_id ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE run_id ON TABLE delegated_to TYPE record<workflow_run>;
DEFINE FIELD OVERWRITE parent_execution_id ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE child_execution_id ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE parent_agent_id ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE child_agent_id ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE delegation_task_id ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE objective ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE reason ON TABLE delegated_to TYPE string;
DEFINE FIELD OVERWRITE depth ON TABLE delegated_to TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE status ON TABLE delegated_to TYPE string ASSERT $value IN ['requested', 'accepted', 'running', 'completed', 'failed', 'rejected'];
DEFINE FIELD OVERWRITE input_artifact_ids ON TABLE delegated_to TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE output_artifact_ids ON TABLE delegated_to TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE error ON TABLE delegated_to TYPE option<string>;
DEFINE FIELD OVERWRITE created_at ON TABLE delegated_to TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE completed_at ON TABLE delegated_to TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS idx_delegated_to_run ON TABLE delegated_to COLUMNS run_id;

DEFINE TABLE OVERWRITE tool_invocation SCHEMAFULL;
DEFINE FIELD OVERWRITE run_id ON TABLE tool_invocation TYPE record<workflow_run>;
DEFINE FIELD OVERWRITE execution_id ON TABLE tool_invocation TYPE string;
DEFINE FIELD OVERWRITE tool_name ON TABLE tool_invocation TYPE string;
DEFINE FIELD OVERWRITE status ON TABLE tool_invocation TYPE string ASSERT $value IN ['pending', 'running', 'completed', 'failed'];
DEFINE FIELD OVERWRITE duration_ms ON TABLE tool_invocation TYPE float DEFAULT 0.0;
DEFINE FIELD OVERWRITE sanitized_input ON TABLE tool_invocation TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE output_summary ON TABLE tool_invocation TYPE string DEFAULT '';
DEFINE FIELD OVERWRITE output_ref ON TABLE tool_invocation TYPE option<string>;
DEFINE FIELD OVERWRITE error ON TABLE tool_invocation TYPE option<string>;
DEFINE FIELD OVERWRITE started_at ON TABLE tool_invocation TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE completed_at ON TABLE tool_invocation TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS idx_tool_invocation_run ON TABLE tool_invocation COLUMNS run_id;
DEFINE INDEX IF NOT EXISTS idx_tool_invocation_execution ON TABLE tool_invocation COLUMNS execution_id;

DEFINE TABLE OVERWRITE artifact SCHEMAFULL;
DEFINE FIELD OVERWRITE run_id ON TABLE artifact TYPE record<workflow_run>;
DEFINE FIELD OVERWRITE task_id ON TABLE artifact TYPE string;
DEFINE FIELD OVERWRITE agent_execution_id ON TABLE artifact TYPE string;
DEFINE FIELD OVERWRITE type ON TABLE artifact TYPE string ASSERT $value IN ['research_report', 'finding', 'evidence', 'question_set', 'recommendation', 'validation_result'];
DEFINE FIELD OVERWRITE title ON TABLE artifact TYPE string;
DEFINE FIELD OVERWRITE version ON TABLE artifact TYPE int DEFAULT 1;
DEFINE FIELD OVERWRITE surreal_record_id ON TABLE artifact TYPE option<string>;
DEFINE FIELD OVERWRITE evidence_ids ON TABLE artifact TYPE array<string> DEFAULT [];
DEFINE FIELD OVERWRITE source_links ON TABLE artifact TYPE array<object> DEFAULT [];
DEFINE FIELD OVERWRITE source_links.* ON TABLE artifact TYPE object FLEXIBLE;
DEFINE FIELD OVERWRITE evidence ON TABLE artifact TYPE option<object>;
DEFINE FIELD OVERWRITE evidence.* ON TABLE artifact TYPE any;
DEFINE FIELD OVERWRITE content ON TABLE artifact TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE created_at ON TABLE artifact TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_artifact_run ON TABLE artifact COLUMNS run_id;

DEFINE TABLE OVERWRITE execution_event SCHEMAFULL;
DEFINE FIELD OVERWRITE schema_version ON TABLE execution_event TYPE string DEFAULT '1.0';
DEFINE FIELD OVERWRITE event_id ON TABLE execution_event TYPE string;
DEFINE FIELD OVERWRITE run_id ON TABLE execution_event TYPE record<workflow_run>;
DEFINE FIELD OVERWRITE seq ON TABLE execution_event TYPE int;
DEFINE FIELD OVERWRITE ts ON TABLE execution_event TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE type ON TABLE execution_event TYPE string;
DEFINE FIELD OVERWRITE task_id ON TABLE execution_event TYPE option<string>;
DEFINE FIELD OVERWRITE execution_id ON TABLE execution_event TYPE option<string>;
DEFINE FIELD OVERWRITE parent_execution_id ON TABLE execution_event TYPE option<string>;
DEFINE FIELD OVERWRITE tool_invocation_id ON TABLE execution_event TYPE option<string>;
DEFINE FIELD OVERWRITE correlation_id ON TABLE execution_event TYPE option<string>;
DEFINE FIELD OVERWRITE trace_id ON TABLE execution_event TYPE option<string>;
DEFINE FIELD OVERWRITE payload ON TABLE execution_event TYPE object FLEXIBLE DEFAULT {};
DEFINE INDEX IF NOT EXISTS idx_execution_event_run_seq ON TABLE execution_event COLUMNS run_id, seq UNIQUE;

DEFINE TABLE OVERWRITE execution_log SCHEMAFULL;
DEFINE FIELD OVERWRITE run_id ON TABLE execution_log TYPE record<workflow_run>;
DEFINE FIELD OVERWRITE seq ON TABLE execution_log TYPE option<int>;
DEFINE FIELD OVERWRITE task_id ON TABLE execution_log TYPE option<string>;
DEFINE FIELD OVERWRITE execution_id ON TABLE execution_log TYPE option<string>;
DEFINE FIELD OVERWRITE tool_invocation_id ON TABLE execution_log TYPE option<string>;
DEFINE FIELD OVERWRITE trace_id ON TABLE execution_log TYPE option<string>;
DEFINE FIELD OVERWRITE component ON TABLE execution_log TYPE string DEFAULT 'orchestration';
DEFINE FIELD OVERWRITE severity ON TABLE execution_log TYPE string ASSERT $value IN ['debug', 'info', 'warn', 'error'] DEFAULT 'info';
DEFINE FIELD OVERWRITE message ON TABLE execution_log TYPE string;
DEFINE FIELD OVERWRITE duration_ms ON TABLE execution_log TYPE option<float>;
DEFINE FIELD OVERWRITE error_category ON TABLE execution_log TYPE option<string>;
DEFINE FIELD OVERWRITE attributes ON TABLE execution_log TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD OVERWRITE ts ON TABLE execution_log TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_execution_log_run ON TABLE execution_log COLUMNS run_id;

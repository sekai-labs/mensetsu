{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "@mensetsu/contracts": ["../../server/api/contracts/src/index.ts"]
    }
  },
  "include": [
    "**/*",
    ".nuxt/nuxt.d.ts"
  ]
}

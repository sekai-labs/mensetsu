---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import { getWorkspaceLinks } from '../data/workspace';

const links = getWorkspaceLinks();
---

<Layout
  title="Page not found | Mensetsu Documentation"
  description="The requested Mensetsu page does not exist."
>
  <section class="max-w-3xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="text-xs font-mono font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
      404 / Not Found
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
      This page is not in the documentation tree.
    </h1>
    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
      The address may have changed. Start from the overview, or continue to the authenticated workspace.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <Button href="/docs/" variant="primary">Documentation overview</Button>
      <Button href={links.loginUrl} variant="outline">Sign in to workspace</Button>
    </div>
  </section>
</Layout>

---
import { getWorkspaceLinks } from '~/data/workspace';

const links = getWorkspaceLinks();
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-12 text-sm text-slate-600 dark:text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Identity -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2">
          <img src="/logo.svg" alt="Mensetsu" class="w-6 h-6 rounded" />
          <span class="font-bold text-slate-900 dark:text-white">Mensetsu (面接)</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Self-hosted, evidence-backed preparation workspace for technical interviews. Connects claims to sources, highlights experience gaps, and builds structured learning plans.
        </p>
        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-800 text-[10px] font-mono text-slate-500">
          <span>Licensed under</span>
          <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener noreferrer" class="underline hover:text-indigo-600">
            Apache-2.0
          </a>
        </div>
      </div>

      <!-- Col 2: Documentation -->
      <div class="space-y-2">
        <div class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Documentation
        </div>
        <ul class="space-y-1.5 text-xs font-mono">
          <li>
            <a href="/docs" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              System Overview
            </a>
          </li>
          <li>
            <a href="/docs/setup" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Local Setup & Docker
            </a>
          </li>
          <li>
            <a href="/docs/workflows" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Research Pipeline
            </a>
          </li>
          <li>
            <a href="/docs/architecture" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Architecture & gRPC
            </a>
          </li>
          <li>
            <a href="/docs/modules" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Module Tree & Ownership
            </a>
          </li>
          <li>
            <a href="/docs/auth" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              OAuth & OIDC Setup
            </a>
          </li>
          <li>
            <a href="/docs/metrics" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Metrics & Usage
            </a>
          </li>
          <li>
            <a href="/docs/security" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Security & SSRF Boundaries
            </a>
          </li>
          <li>
            <a href="/docs/operations" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Operations & Maintenance
            </a>
          </li>
          <li>
            <a href="/docs/contributing" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Contributing Standards
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Architecture & Ecosystem -->
      <div class="space-y-2">
        <div class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Stack & Clients
        </div>
        <ul class="space-y-1.5 text-xs text-slate-500 dark:text-slate-400">
          <li>Rust Axum API (Port 3000)</li>
          <li>Python Intelligence gRPC (Port 50051)</li>
          <li>Nuxt 3 Web Client (Port 3001)</li>
          <li>Astro Landing & Docs (Port 3002)</li>
          <li>SurrealDB Multi-Model & Vector</li>
          <li>Manifest V3 Chrome/Firefox Extension</li>
          <li>Native Clients (Android, iOS, Desktop)</li>
        </ul>
      </div>

      <!-- Col 4: Workspace Handoff -->
      <div class="space-y-2">
        <div class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Workspace Access
        </div>
        <ul class="space-y-1.5 text-xs font-mono">
          <li>
            <a href={links.baseUrl} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Workspace Host ({links.baseUrl})
            </a>
          </li>
          <li>
            <a href={links.loginUrl} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Candidate Sign In
            </a>
          </li>
          <li>
            <a href={links.registerUrl} class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Create Account
            </a>
          </li>
        </ul>
        <div class="pt-3 text-[11px] text-slate-500 dark:text-slate-400 leading-normal">
          Controlled environment: you deploy the services and control where your candidate data is stored.
        </div>
      </div>
    </div>

    <!-- Bottom verification reminder -->
    <div class="border-t border-slate-100 dark:border-slate-800/80 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <div>
        Mensetsu (面接) — Evidence-Backed Technical Interview Workspace
      </div>
      <div class="text-[11px] font-mono text-slate-400 dark:text-slate-500">
        AI output is assistive. Always verify critical claims against cited sources.
      </div>
    </div>
  </div>
</footer>

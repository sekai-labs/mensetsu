---
import { getWorkspaceLinks } from '~/data/workspace';
import Button from '../ui/Button.astro';

const links = getWorkspaceLinks();
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group">
      <img src="/logo.svg" alt="Mensetsu Logo" class="w-8 h-8 rounded-lg shadow-xs group-hover:scale-105 transition-transform" />
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 font-bold text-slate-900 dark:text-white tracking-tight leading-none text-base">
          <span>Mensetsu</span>
          <span class="text-xs font-mono font-normal text-indigo-600 dark:text-indigo-400">面接</span>
        </div>
        <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 leading-tight">
          Evidence-Backed Workspace
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="/#capabilities" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
        Capabilities
      </a>
      <a href="/#pipeline" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
        Pipeline
      </a>
      <a href="/#architecture" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
        Architecture
      </a>
      <a href="/docs" class="flex items-center gap-1 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
        <span>Documentation</span>
      </a>
    </nav>

    <!-- Desktop Action Links -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={links.loginUrl}
        class="text-xs font-mono font-medium text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 px-2 py-1 transition-colors"
      >
        Sign In
      </a>

      <Button href={links.registerUrl} size="sm" variant="primary">
        <span>Open Workspace</span>
        <span class="ml-1 text-xs">↗</span>
      </Button>
    </div>

    <!-- Mobile Action -->
    <div class="flex sm:hidden items-center gap-2">
      <Button href={links.loginUrl} size="xs" variant="outline">
        Sign In
      </Button>
      <Button href="/docs" size="xs" variant="primary">
        Docs
      </Button>
    </div>
  </div>
</header>

---
const features = [
  {
    title: 'Candidate Profile & CV Library',
    desc: 'Keep reusable PDF résumés, contact details, role targets, and location preferences stored privately in your self-hosted S3-compatible bucket.',
    evidence: 'Private presigned URLs, zero third-party data broker sharing.',
  },
  {
    title: 'Citation Provenance First',
    desc: 'Every external claim about company culture, engineering practices, or tech stacks includes verifiable source URLs, retrieval dates, and snippets.',
    evidence: 'Mandatory source URL, snippet, and confidence rating on all facts.',
  },
  {
    title: 'Explainable Match Analysis',
    desc: 'Transparent decomposition of role requirements against your CV. No mysterious percentage numbers without concrete cited evidence quotes and gaps.',
    evidence: 'Categorized into required vs. preferred with line-level quotes.',
  },
  {
    title: 'SurrealDB Multi-Model Graph',
    desc: 'Interconnected graph linking companies, roles, skills, requirements, claims, and technical concepts with bidirectional traversals.',
    evidence: 'SurrealQL graph relations (->rel->, <-rel<-) and vector search.',
  },
  {
    title: 'Prerequisite-Ordered Learning Path',
    desc: 'Targeted syllabus tailored to bridge your exact experience gaps before interview day, accompanied by clear dependency diagrams.',
    evidence: 'Topologically ordered modules, avoiding prerequisite inversions.',
  },
  {
    title: 'Grounded Interview Question Book',
    desc: 'Comprehensive interview questions (deep-dive, system design, fundamentals, behavioral) with evaluation rubrics, pitfalls, and follow-up prompts.',
    evidence: 'Multi-mode practice (flashcard, written, timed) with scoring rubrics.',
  },
];
---

<section id="capabilities" class="py-16 sm:py-24 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Section Header -->
    <div class="space-y-3 max-w-3xl">
      <div class="text-xs font-mono font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
        Verified Capabilities
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
        Information-dense preparation for serious engineering candidates.
      </h2>
      <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Mensetsu is deliberately designed with calm density: no generic AI chatbots, no fabricated ratings, and no hype. Every tool is built to provide verifiable, reproducible insight.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        features.map((feature, idx) => (
          <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition-colors shadow-xs">
            <div class="w-10 h-10 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-mono font-bold text-xs">
              0{idx + 1}
            </div>

            <div class="space-y-2">
              <h3 class="text-base font-semibold text-slate-900 dark:text-white">
                {feature.title}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {feature.desc}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 text-[11px] font-mono text-slate-500 dark:text-slate-400">
              <span class="text-indigo-600 dark:text-indigo-400 font-semibold">Invariant: </span>
              <span>{feature.evidence}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
interface Props {
  code: string;
  language?: string;
  filename?: string;
}

const { code, language = 'bash', filename } = Astro.props;
---

<div class="my-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-900 text-slate-100 overflow-hidden shadow-xs">
  <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 bg-slate-950/70 text-xs font-mono">
    <span class="text-slate-400">{filename || language}</span>
    <button
      type="button"
      data-code={code}
      class="copy-btn inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-mono text-slate-400 hover:text-slate-200 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded transition-colors"
    >
      Copy
    </button>
  </div>
  <div class="p-4 overflow-x-auto text-xs font-mono leading-relaxed text-slate-200">
    <pre><code>{code}</code></pre>
  </div>
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (code) {
        try {
          await navigator.clipboard.writeText(code);
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => {
            btn.textContent = orig;
          }, 2000);
        } catch {}
      }
    });
  });
</script>

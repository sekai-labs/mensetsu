DEFINE FIELD OVERWRITE source_url ON TABLE claim TYPE option<string>;
DEFINE FIELD OVERWRITE evidence_snippet ON TABLE claim TYPE option<string>;
DEFINE FIELD OVERWRITE contradiction_note ON TABLE claim TYPE option<string>;
DEFINE FIELD OVERWRITE conflicting_claim_id ON TABLE claim TYPE option<record<claim>>;
DEFINE FIELD OVERWRITE created_at ON TABLE claim TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_claim_workspace ON TABLE claim COLUMNS workspace_id;

DEFINE TABLE OVERWRITE skill SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE skill TYPE option<record<workspace>>;
DEFINE FIELD OVERWRITE name ON TABLE skill TYPE string;
DEFINE FIELD OVERWRITE slug ON TABLE skill TYPE string;
DEFINE FIELD OVERWRITE category ON TABLE skill TYPE string;
DEFINE FIELD OVERWRITE candidate_status ON TABLE skill TYPE option<string>;
DEFINE FIELD OVERWRITE importance ON TABLE skill TYPE option<string>;
DEFINE FIELD OVERWRITE description ON TABLE skill TYPE option<string>;
DEFINE INDEX IF NOT EXISTS idx_skill_ws ON TABLE skill COLUMNS workspace_id;

DEFINE TABLE OVERWRITE skill_relation SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE skill_relation TYPE option<record<workspace>>;
DEFINE FIELD OVERWRITE source ON TABLE skill_relation TYPE string;
DEFINE FIELD OVERWRITE target ON TABLE skill_relation TYPE string;
DEFINE FIELD OVERWRITE relation ON TABLE skill_relation TYPE string;
DEFINE INDEX IF NOT EXISTS idx_skill_rel_ws ON TABLE skill_relation COLUMNS workspace_id;
DEFINE TABLE OVERWRITE concept SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE concept TYPE string;
DEFINE FIELD OVERWRITE description ON TABLE concept TYPE string;

DEFINE TABLE OVERWRITE company_entity SCHEMAFULL;
DEFINE FIELD OVERWRITE name ON TABLE company_entity TYPE string;
DEFINE FIELD OVERWRITE domain ON TABLE company_entity TYPE option<string>;
DEFINE FIELD OVERWRITE overview ON TABLE company_entity TYPE string;
DEFINE FIELD OVERWRITE business_model ON TABLE company_entity TYPE string;

DEFINE TABLE OVERWRITE rel_requires TYPE RELATION IN role_entity OUT skill SCHEMAFULL;
DEFINE FIELD OVERWRITE importance ON TABLE rel_requires TYPE string ASSERT $value IN ['mandatory', 'preferred'];

DEFINE TABLE OVERWRITE rel_has_skill TYPE RELATION IN resume OUT skill SCHEMAFULL;
DEFINE FIELD OVERWRITE confidence ON TABLE rel_has_skill TYPE number;
DEFINE FIELD OVERWRITE evidence_quote ON TABLE rel_has_skill TYPE string;

DEFINE TABLE OVERWRITE rel_depends_on TYPE RELATION IN skill OUT skill SCHEMAFULL;
DEFINE FIELD OVERWRITE order ON TABLE rel_depends_on TYPE int;

DEFINE TABLE OVERWRITE rel_supports TYPE RELATION IN source OUT claim SCHEMAFULL;
DEFINE FIELD OVERWRITE quote ON TABLE rel_supports TYPE string;

DEFINE TABLE OVERWRITE rel_describes TYPE RELATION IN claim OUT company_entity SCHEMAFULL;


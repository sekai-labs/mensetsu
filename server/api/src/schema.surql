DEFINE FIELD OVERWRITE video_title ON TABLE learning_unit TYPE option<string>;
DEFINE FIELD OVERWRITE chapters ON TABLE learning_unit TYPE option<array<object>>;
DEFINE FIELD OVERWRITE chapters.* ON TABLE learning_unit TYPE any;
DEFINE FIELD OVERWRITE diagram.* ON TABLE learning_unit TYPE any;
DEFINE FIELD OVERWRITE completed ON TABLE learning_unit TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE created_at ON TABLE learning_unit TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_learning_workspace ON TABLE learning_unit COLUMNS workspace_id;


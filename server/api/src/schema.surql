DEFINE FIELD OVERWRITE workspace_id ON TABLE learning_unit TYPE record<workspace>;
DEFINE FIELD OVERWRITE skill ON TABLE learning_unit TYPE string;
DEFINE FIELD OVERWRITE title ON TABLE learning_unit TYPE string;
DEFINE FIELD OVERWRITE prerequisites ON TABLE learning_unit TYPE array<string>;
DEFINE FIELD OVERWRITE estimated_minutes ON TABLE learning_unit TYPE int;

DEFINE NAMESPACE IF NOT EXISTS mensetsu;
USE NS mensetsu;
DEFINE DATABASE IF NOT EXISTS production;
USE NS mensetsu DB production;

DEFINE TABLE OVERWRITE user SCHEMAFULL;
DEFINE FIELD OVERWRITE email ON TABLE user TYPE string ASSERT string::is_email($value);
DEFINE FIELD OVERWRITE name ON TABLE user TYPE string;
DEFINE FIELD OVERWRITE password_hash ON TABLE user TYPE string;
DEFINE FIELD OVERWRITE status ON TABLE user TYPE option<string>;
DEFINE FIELD OVERWRITE role ON TABLE user TYPE string ASSERT $value IN ['admin', 'member'] DEFAULT 'member';
DEFINE FIELD OVERWRITE totp_enabled ON TABLE user TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE totp_secret ON TABLE user TYPE option<string>;
DEFINE FIELD OVERWRITE created_at ON TABLE user TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE updated_at ON TABLE user TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_user_email ON TABLE user COLUMNS email UNIQUE;

DEFINE TABLE OVERWRITE auth_session SCHEMAFULL;
DEFINE FIELD OVERWRITE user_id ON TABLE auth_session TYPE record<user>;
DEFINE FIELD OVERWRITE refresh_token_hash ON TABLE auth_session TYPE string;
DEFINE FIELD OVERWRITE user_agent ON TABLE auth_session TYPE option<string>;
DEFINE FIELD OVERWRITE ip_address ON TABLE auth_session TYPE option<string>;
DEFINE FIELD OVERWRITE expires_at ON TABLE auth_session TYPE datetime;
DEFINE FIELD OVERWRITE created_at ON TABLE auth_session TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE last_used_at ON TABLE auth_session TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE revoked ON TABLE auth_session TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE updated_at ON TABLE auth_session TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS idx_session_hash ON TABLE auth_session COLUMNS refresh_token_hash;
DEFINE INDEX IF NOT EXISTS idx_session_user ON TABLE auth_session COLUMNS user_id;

DEFINE TABLE OVERWRITE user_llm_config SCHEMAFULL;
DEFINE FIELD OVERWRITE user_id ON TABLE user_llm_config TYPE record<user>;
DEFINE FIELD OVERWRITE provider ON TABLE user_llm_config TYPE string ASSERT $value IN ['openai', 'anthropic', 'openrouter', 'ollama', 'custom'];
DEFINE FIELD OVERWRITE encrypted_api_key ON TABLE user_llm_config TYPE option<string>;
DEFINE FIELD OVERWRITE base_url ON TABLE user_llm_config TYPE option<string>;
DEFINE FIELD OVERWRITE model_chat ON TABLE user_llm_config TYPE option<string>;
DEFINE FIELD OVERWRITE model_search ON TABLE user_llm_config TYPE option<string>;
DEFINE FIELD OVERWRITE model_embed ON TABLE user_llm_config TYPE option<string>;
DEFINE FIELD OVERWRITE is_shared ON TABLE user_llm_config TYPE bool DEFAULT false;
DEFINE FIELD OVERWRITE created_at ON TABLE user_llm_config TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE updated_at ON TABLE user_llm_config TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_user_provider ON TABLE user_llm_config COLUMNS user_id, provider UNIQUE;
DEFINE TABLE OVERWRITE workspace SCHEMAFULL;
DEFINE FIELD OVERWRITE user_id ON TABLE workspace TYPE record<user>;
DEFINE FIELD OVERWRITE company_name ON TABLE workspace TYPE string;
DEFINE FIELD OVERWRITE role_title ON TABLE workspace TYPE string;
DEFINE FIELD OVERWRITE status ON TABLE workspace TYPE string ASSERT $value IN ['pending', 'processing', 'ready', 'failed'];
DEFINE FIELD OVERWRITE current_phase ON TABLE workspace TYPE string;
DEFINE FIELD OVERWRITE progress_percent ON TABLE workspace TYPE number ASSERT $value >= 0 AND $value <= 100;
DEFINE FIELD OVERWRITE seniority ON TABLE workspace TYPE option<string>;
DEFINE FIELD OVERWRITE target_date ON TABLE workspace TYPE option<datetime>;
DEFINE FIELD OVERWRITE prep_time_weeks ON TABLE workspace TYPE option<int>;
DEFINE FIELD OVERWRITE company_urls ON TABLE workspace TYPE option<array<string>>;
DEFINE FIELD OVERWRITE created_at ON TABLE workspace TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE updated_at ON TABLE workspace TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_workspace_user ON TABLE workspace COLUMNS user_id;

DEFINE TABLE OVERWRITE resume SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE resume TYPE record<workspace>;
DEFINE FIELD OVERWRITE candidate_name ON TABLE resume TYPE option<string>;
DEFINE FIELD OVERWRITE summary ON TABLE resume TYPE option<string>;
DEFINE FIELD OVERWRITE raw_text ON TABLE resume TYPE string;
DEFINE FIELD OVERWRITE source_pdf_base64 ON TABLE resume TYPE option<string>;
DEFINE FIELD OVERWRITE source_filename ON TABLE resume TYPE option<string>;
DEFINE FIELD OVERWRITE parsed_skills ON TABLE resume TYPE array<string>;
DEFINE FIELD OVERWRITE extracted_skills ON TABLE resume TYPE option<array<object>>;
DEFINE FIELD OVERWRITE extracted_skills.* ON TABLE resume TYPE any;
DEFINE FIELD OVERWRITE experience ON TABLE resume TYPE array<object>;
DEFINE FIELD OVERWRITE experience.* ON TABLE resume TYPE any;
DEFINE FIELD OVERWRITE experience_highlights ON TABLE resume TYPE option<array<string>>;
DEFINE FIELD OVERWRITE education ON TABLE resume TYPE array<object>;
DEFINE FIELD OVERWRITE education.* ON TABLE resume TYPE any;
DEFINE FIELD OVERWRITE created_at ON TABLE resume TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_resume_workspace ON TABLE resume COLUMNS workspace_id UNIQUE;

DEFINE TABLE OVERWRITE job_description SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE job_description TYPE record<workspace>;
DEFINE FIELD OVERWRITE title ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE role_summary ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE canonical_url ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE jd_url ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE source_url ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE department ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE employment_type ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE seniority ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE locations ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE remote_policy ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE salary ON TABLE job_description TYPE option<object>;
DEFINE FIELD OVERWRITE salary.* ON TABLE job_description TYPE any;
DEFINE FIELD OVERWRITE raw_text ON TABLE job_description TYPE string;
DEFINE FIELD OVERWRITE requirements ON TABLE job_description TYPE array<object>;
DEFINE FIELD OVERWRITE requirements.* ON TABLE job_description TYPE any;
DEFINE FIELD OVERWRITE responsibilities ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE required_qualifications ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE preferred_qualifications ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE technical_skills ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE soft_skills ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE experience_requirements ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE education_requirements ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE benefits ON TABLE job_description TYPE option<array<string>>;
DEFINE FIELD OVERWRITE application_url ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE posted_at ON TABLE job_description TYPE option<datetime>;
DEFINE FIELD OVERWRITE valid_through ON TABLE job_description TYPE option<datetime>;
DEFINE FIELD OVERWRITE retrieved_at ON TABLE job_description TYPE option<datetime>;
DEFINE FIELD OVERWRITE extraction_method ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE extraction_confidence ON TABLE job_description TYPE option<number>;
DEFINE FIELD OVERWRITE source_evidence ON TABLE job_description TYPE option<array<object>>;
DEFINE FIELD OVERWRITE source_evidence.* ON TABLE job_description TYPE any;
DEFINE FIELD OVERWRITE raw_content_reference ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE schema_version ON TABLE job_description TYPE option<string>;
DEFINE FIELD OVERWRITE created_at ON TABLE job_description TYPE datetime DEFAULT time::now();
DEFINE FIELD OVERWRITE updated_at ON TABLE job_description TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_jd_workspace ON TABLE job_description COLUMNS workspace_id UNIQUE;

DEFINE TABLE OVERWRITE match_analysis SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE match_analysis TYPE record<workspace>;
DEFINE FIELD OVERWRITE overall_match_ratio ON TABLE match_analysis TYPE number;
DEFINE FIELD OVERWRITE strengths ON TABLE match_analysis TYPE array<object>;
DEFINE FIELD OVERWRITE strengths.* ON TABLE match_analysis TYPE object;
DEFINE FIELD OVERWRITE strengths.*.skill ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE strengths.*.evidence_quote ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE strengths.*.relevance ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps ON TABLE match_analysis TYPE array<object>;
DEFINE FIELD OVERWRITE gaps.* ON TABLE match_analysis TYPE object;
DEFINE FIELD OVERWRITE gaps.*.skill ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps.*.importance ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps.*.requirement_quote ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE gaps.*.recommended_focus ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE risks ON TABLE match_analysis TYPE array<string>;
DEFINE FIELD OVERWRITE wording_improvements ON TABLE match_analysis TYPE array<object>;
DEFINE FIELD OVERWRITE wording_improvements.* ON TABLE match_analysis TYPE object;
DEFINE FIELD OVERWRITE wording_improvements.*.original_text ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE wording_improvements.*.suggested_revision ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE wording_improvements.*.rationale ON TABLE match_analysis TYPE string;
DEFINE FIELD OVERWRITE created_at ON TABLE match_analysis TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_match_workspace ON TABLE match_analysis COLUMNS workspace_id UNIQUE;

DEFINE TABLE OVERWRITE source SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE source TYPE record<workspace>;
DEFINE FIELD OVERWRITE url ON TABLE source TYPE string;
DEFINE FIELD OVERWRITE title ON TABLE source TYPE string;
DEFINE FIELD OVERWRITE domain ON TABLE source TYPE string;
DEFINE FIELD OVERWRITE snippet ON TABLE source TYPE string;
DEFINE FIELD OVERWRITE source_type ON TABLE source TYPE string;
DEFINE FIELD OVERWRITE confidence ON TABLE source TYPE number;
DEFINE FIELD OVERWRITE content_hash ON TABLE source TYPE option<string>;
DEFINE FIELD OVERWRITE retrieval_method ON TABLE source TYPE option<string>;
DEFINE FIELD OVERWRITE raw_snapshot_reference ON TABLE source TYPE option<string>;
DEFINE FIELD OVERWRITE publisher ON TABLE source TYPE option<string>;
DEFINE FIELD OVERWRITE published_date ON TABLE source TYPE option<string>;
DEFINE FIELD OVERWRITE access_status ON TABLE source TYPE option<string>;
DEFINE FIELD OVERWRITE freshness_metadata ON TABLE source TYPE option<object>;
DEFINE FIELD OVERWRITE retrieved_at ON TABLE source TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_source_workspace ON TABLE source COLUMNS workspace_id;

DEFINE TABLE OVERWRITE source_chunk SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE source_chunk TYPE record<workspace>;
DEFINE FIELD OVERWRITE source_id ON TABLE source_chunk TYPE record<source>;
DEFINE FIELD OVERWRITE chunk_index ON TABLE source_chunk TYPE int;
DEFINE FIELD OVERWRITE content ON TABLE source_chunk TYPE string;
DEFINE FIELD OVERWRITE start_char ON TABLE source_chunk TYPE option<int>;
DEFINE FIELD OVERWRITE end_char ON TABLE source_chunk TYPE option<int>;
DEFINE FIELD OVERWRITE created_at ON TABLE source_chunk TYPE datetime DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_chunk_source ON TABLE source_chunk COLUMNS source_id;
DEFINE INDEX IF NOT EXISTS idx_chunk_workspace ON TABLE source_chunk COLUMNS workspace_id;

DEFINE TABLE OVERWRITE claim SCHEMAFULL;
DEFINE FIELD OVERWRITE workspace_id ON TABLE claim TYPE record<workspace>;
DEFINE FIELD OVERWRITE statement ON TABLE claim TYPE string;
DEFINE FIELD OVERWRITE claim_type ON TABLE claim TYPE string;
DEFINE FIELD OVERWRITE classification ON TABLE claim TYPE option<string>;
DEFINE FIELD OVERWRITE confidence ON TABLE claim TYPE number;

    "/api/v1/settings/llm/{provider}": {
      "delete": {
        "tags": [
          "settings"
        ],
        "operationId": "delete_llm_setting",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "LLM provider setting removed"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },

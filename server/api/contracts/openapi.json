  "paths": {
    "/api/v1/auth/2fa/disable": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "disable_2fa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyTotpRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Disable 2FA",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid code"
          }
        }
      }
    },
    "/api/v1/auth/2fa/setup": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "setup_2fa",
        "responses": {
          "200": {
            "description": "Initiate 2FA setup and get QR code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpSetupResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/2fa/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "verify_2fa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyTotpRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Verify code and activate 2FA",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid code"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {

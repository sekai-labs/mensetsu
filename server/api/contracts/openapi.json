                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or account suspended"
          }
        }
      }
    },
    "/api/v1/auth/login-2fa": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login_2fa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login2faRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
